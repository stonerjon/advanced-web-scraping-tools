{
  "default_provider": "local-ollama",
  "providers": {
    "local-ollama": {
      "type": "ollama",
      "base_url": "http://localhost:11434",
      "model": "llama3.2",
      "timeout": 30
    },
    "cloudflare-workers-ai": {
      "type": "cloudflare-workers-ai",
      "chat_completions_url": "https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai/v1/chat/completions",
      "api_key_env": "CLOUDFLARE_API_TOKEN",
      "model": "@cf/meta/llama-3.1-8b-instruct",
      "timeout": 45
    },
    "cloudflare-ai-gateway": {
      "type": "cloudflare-ai-gateway",
      "chat_completions_url": "https://gateway.ai.cloudflare.com/v1/ACCOUNT_ID/GATEWAY_ID/compat/chat/completions",
      "api_key_env": "AI_GATEWAY_TOKEN",
      "model": "provider/model-id",
      "timeout": 45
    },
    "account-owned-worker-gateway": {
      "type": "worker-gateway",
      "chat_completions_url": "https://your-worker.example.workers.dev/v1/chat/completions",
      "api_key_env": "WORKER_GATEWAY_TOKEN",
      "model": "your-configured-model",
      "timeout": 45
    },
    "paid-openai-compatible": {
      "type": "openai-compatible",
      "chat_completions_url": "https://api.example-provider.test/v1/chat/completions",
      "api_key_env": "PAID_LLM_API_KEY",
      "model": "provider-model-id",
      "timeout": 45
    },
    "opencode-cli": {
      "type": "opencode",
      "enabled": false,
      "model": "provider/model"
    },
    "claude-code-cli": {
      "type": "claude-code",
      "enabled": false,
      "model": "sonnet"
    }
  }
}
